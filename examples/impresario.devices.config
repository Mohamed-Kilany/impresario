devices:
  - name: living_room_tv
    platform: webos
    connection:
      transport: ssh
      host: 192.168.1.50
      endpoint: ws://192.168.1.50:9998
    labels: [tv, living_room]
  - name: flagship_android
    platform: android
    connection:
      transport: usb
      serial: emulator-5554
    labels: [phone]
  - name: shield_tv
    platform: androidtv
    connection:
      transport: tcp
      host: 192.168.1.60
      port: 5555
    labels: [tv]
  - name: test_iphone
    platform: ios
    connection:
      udid: 00008110-001A2345021E001E
  - name: apple_tv
    platform: tvos
    connection:
      udid: 00008110-001B3456021E002F
      endpoint: 192.168.1.70:50062
  # A local Chromium instance started by the connector; uncomment to try the
  # example on this machine (TASK-2 section 4.3).
  # - name: local_chrome
  #   platform: web
  #   connection:
  #     transport: launch
