# Apps are separate from devices (D-21). A play binds to one with `App: shop`;
# `impresario run --app shop` overrides the play header. `package` is optional:
# when set, the planner checks the artifact exists before touching hardware.
apps:
  - name: shop
    description: Example store app across phone, TV and web
    platforms:
      web:
        url: http://localhost:8080/index.html
      webos:
        id: com.example.shop
      tizen:
        id: AbCdEf1234.Shop
      android:
        id: com.example.shop
      androidtv:
        id: com.example.shop.tv
      ios:
        id: com.example.shop
      tvos:
        id: com.example.shop.tv
    options:
      clear_data: false
